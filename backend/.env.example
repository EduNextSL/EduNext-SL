# Copy to .env and fill in. Names only; never commit real values.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/

# Neon: DATABASE_URL = the POOLED connection string (host contains "-pooler"), used by the app.
# DIRECT_DATABASE_URL = the direct connection string, used only to run migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DB_CONN_MAX_AGE=60
# A shared cache is REQUIRED in production so throttling works across processes,
# e.g. redis://localhost:6379/1 (needs a Redis cache package) or a database cache.
CACHE_URL=locmemcache://edunext

# Frontend / CORS / CSRF
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_PASSWORD_RESET_PATH=/reset-password
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Auth cookie / tokens
AUTH_COOKIE_NAME=edunext_refresh
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
JWT_ACCESS_MINUTES=10
JWT_REFRESH_SESSION_HOURS=24
JWT_REFRESH_REMEMBER_DAYS=30
PASSWORD_RESET_TIMEOUT_SECONDS=3600
PASSWORD_MIN_LENGTH=10

# Legal document versions recorded at registration (set to your real published versions)
LEGAL_TERMS_VERSION=
LEGAL_USER_AGREEMENT_VERSION=
LEGAL_PRIVACY_POLICY_VERSION=

# Email via Brevo. BREVO_API_KEY must be an API key (starts xkeysib-): Brevo > SMTP & API > API Keys.
# (An SMTP key, xsmtpsib-, also needs BREVO_SMTP_LOGIN and only works where SMTP is not blocked.)
# EMAIL_FROM_ADDRESS must be a verified sender in Brevo.
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EduNext SL
# Local development without Brevo: leave BREVO_API_KEY empty to print emails to the console.
EMAIL_URL=consolemail://
EMAIL_ASYNC=true
# Public logo used in emails; defaults to the Cloudinary asset edunext/brand/logo
EMAIL_LOGO_URL=

# Cloudinary (photos, videos, documents). Values from the Cloudinary dashboard.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
THROTTLE_RATE_UPLOAD_SIGNATURE=60/hour

# Throttling (DRF rate syntax) and proxy count
TRUSTED_PROXY_COUNT=0
THROTTLE_RATE_ANON=1000/hour
THROTTLE_RATE_USER=2000/hour
THROTTLE_RATE_REGISTER=10/hour
THROTTLE_RATE_LOGIN=20/minute
THROTTLE_RATE_LOGIN_IDENTITY=10/minute
THROTTLE_RATE_PASSWORD_RESET_REQUEST=5/hour
THROTTLE_RATE_PASSWORD_RESET_CONFIRM=10/hour
THROTTLE_RATE_TOKEN_REFRESH=60/minute
THROTTLE_RATE_SOCIAL_LOGIN=20/minute

# Production / staging only
API_DOCS_ENABLED=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_PROXY_SSL_HEADER=

# Google sign-in: OAuth "Web application" client ID from Google Cloud Console.
# Public value (served to the SPA by /api/v1/auth/providers/); no client secret is needed.
# Leave empty to disable the Google button.
GOOGLE_OAUTH_CLIENT_ID=

# Built React app served by Django (output of `npm run build` in the frontend project)
FRONTEND_DIST_DIR=

# Staging on a host without a mail provider: set to false to allow the console email backend
REQUIRE_REAL_EMAIL=true
