# Copy to .env and fill in. Names only; never commit real values.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/

DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/edunext_sl
DB_CONN_MAX_AGE=60
# A shared cache is REQUIRED in production so throttling works across processes,
# e.g. redis://localhost:6379/1 (needs a Redis cache package) or a database cache.
CACHE_URL=locmemcache://edunext

# Frontend / CORS / CSRF
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_PASSWORD_RESET_PATH=/reset-password
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Auth cookie / tokens
AUTH_COOKIE_NAME=edunext_refresh
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
JWT_ACCESS_MINUTES=10
JWT_REFRESH_SESSION_HOURS=24
JWT_REFRESH_REMEMBER_DAYS=30
PASSWORD_RESET_TIMEOUT_SECONDS=3600
PASSWORD_MIN_LENGTH=10

# Legal document versions recorded at registration (set to your real published versions)
LEGAL_TERMS_VERSION=
LEGAL_USER_AGREEMENT_VERSION=
LEGAL_PRIVACY_POLICY_VERSION=

# Email (console backend by default). Example: smtp+tls://USER:PASSWORD@smtp.example.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=EduNext SL <no-reply@example.com>

# Throttling (DRF rate syntax) and proxy count
TRUSTED_PROXY_COUNT=0
THROTTLE_RATE_ANON=1000/hour
THROTTLE_RATE_USER=2000/hour
THROTTLE_RATE_REGISTER=10/hour
THROTTLE_RATE_LOGIN=20/minute
THROTTLE_RATE_LOGIN_IDENTITY=10/minute
THROTTLE_RATE_PASSWORD_RESET_REQUEST=5/hour
THROTTLE_RATE_PASSWORD_RESET_CONFIRM=10/hour
THROTTLE_RATE_TOKEN_REFRESH=60/minute
THROTTLE_RATE_SOCIAL_LOGIN=20/minute

# Production / staging only
API_DOCS_ENABLED=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_PROXY_SSL_HEADER=

# Future social login (not read by the code yet; see apps/accounts/social.py)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
